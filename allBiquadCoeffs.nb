Cell[CellGroupData[{

Cell["HighPass Filter", "Section",
 CellChangeTimes->{{3.958763530261614*^9, 3.958763533617174*^9}, {
  3.958798506274811*^9, 3.9587985098899612`*^9}, {3.958798620216898*^9, 
  3.9587986204678173`*^9}},ExpressionUUID->"c84133d3-eb21-5e47-9cc7-\
8e99ec26db7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"highPassCoeffs", "[", 
   RowBox[{"cutFreq_", ",", "  ", "qFactor_", ",", " ", 
    RowBox[{"sampleRate_", ":", "48000"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fc", "=", "cutFreq"}], ",", " ", 
      RowBox[{"qf", "=", "qFactor"}], ",", " ", 
      RowBox[{"sr", "=", "sampleRate"}], ",", " ", "amp", ",", " ", 
      "\[Omega]0", ",", "a", ",", "  ", "a0", ",", " ", "a1", ",", " ", "a2", 
      ",", " ", "b0", ",", " ", "b1", ",", " ", "b2", ",", " ", "bCoeffs", ",",
       " ", "aCoeffs"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Omega]0", "=", 
      RowBox[{
       RowBox[{"2", "*", "\[Pi]", "*", 
        RowBox[{"(", 
         RowBox[{"fc", "/", "sr"}], ")"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "\[Omega]0", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "qf"}], ")"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bCoeffs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"aCoeffs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b0", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], ")"}], "/", "2."}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b1", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], ")"}]}], "//", "N"}]}], ";",
      " ", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], ")"}], "/", "2."}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a0", "=", 
      RowBox[{
       RowBox[{"1", "+", "a"}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a2", "=", 
      RowBox[{
       RowBox[{"1", "-", "a"}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"List", "[", 
      RowBox[{"bCoeffs", ",", " ", "aCoeffs"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9587504845845585`*^9, 3.9587507437570953`*^9}, {
  3.9587581421497803`*^9, 3.9587581700023823`*^9}, {3.9587582198334217`*^9, 
