Cell[CellGroupData[{

Cell["LowPass Filter", "Section",
 CellChangeTimes->{{3.958763530261614*^9, 3.958763533617174*^9}, {
  3.958798506274811*^9, 
  3.9587985098899612`*^9}},ExpressionUUID->"abfb9a05-584c-df42-89bd-\
bc970c12a96c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lowPassCoeffs", "[", 
   RowBox[{
   "cutFreq_", ",", " ", "dbGain_", ",", " ", "qFactor_", ",", " ", 
    "sampleRate_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fc", "=", "cutFreq"}], ",", " ", 
      RowBox[{"gain", "=", "dbGain"}], ",", " ", 
      RowBox[{"qf", "=", "qFactor"}], ",", " ", 
      RowBox[{"sr", "=", "sampleRate"}], ",", " ", "amp", ",", " ", 
      "\[Omega]0", ",", "a", ",", "  ", "a0", ",", " ", "a1", ",", " ", "a2", 
      ",", " ", "b0", ",", " ", "b1", ",", " ", "b2", ",", " ", "bCoeffs", 
      ",", " ", "aCoeffs"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"amp", "=", 
      RowBox[{
       SuperscriptBox["10", 
        RowBox[{"gain", "/", "40"}]], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Omega]0", "=", 
      RowBox[{
       RowBox[{"2", "*", "\[Pi]", "*", 
        RowBox[{"(", 
         RowBox[{"fc", "/", "sr"}], ")"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "\[Omega]0", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "qf"}], ")"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bCoeffs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"aCoeffs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b0", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], ")"}], "/", "2."}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b1", "=", 
      RowBox[{
       RowBox[{"1", "-", 
        RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], "//", "N"}]}], ";", " ", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], ")"}], "/", "2."}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a0", "=", 
      RowBox[{
       RowBox[{"1", "+", "a"}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"N", "@", 
         RowBox[{"Cos", "[", "\[Omega]0", "]"}]}]}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a2", "=", 
      RowBox[{
       RowBox[{"1", "-", "a"}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"List", "[", 
      RowBox[{"bCoeffs", ",", " ", "aCoeffs"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9587504845845585`*^9, 3.9587507437570953`*^9}, {
