    "\[IndentingNewLine]", "\"\<a1:  \>\""}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Echo", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"a2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"amplitude", "+", "1"}], ")"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"amplitude", "-", "1"}], ")"}], "*", 
         RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], "-", 
        RowBox[{"2", "*", 
         RowBox[{"Sqrt", "[", "amplitude", "]"}], "*", "a"}]}], "//", "N"}]}],
      ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a2"}], "]"}], ";", "a2"}], ",", 
    "\[IndentingNewLine]", "\"\<a2:  \>\""}], "\[IndentingNewLine]", "]"}], 
  ";"}]}], "Input",
