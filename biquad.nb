Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9587311086039085`*^9, 
  3.958731134330488*^9}},ExpressionUUID->"cd30db28-2bd2-f746-9933-\
89f78baf9a7e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fs", "=", "48000"}], ";"}], "                 ", 
  RowBox[{"(*", 
   RowBox[{"Frequenza", " ", "di", " ", "campionamento"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nFreqs", "=", "1024"}], ";"}], "              ", 
  RowBox[{"(*", 
   RowBox[{"Risoluzione", " ", "in", " ", "frequenza"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", "=", 
    RowBox[{"2", "*", "Pi", "*", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"nFreqs", "-", "1"}]}], "]"}], "/", "nFreqs"}]}]}], ";"}], 
  "  ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Frequenze", " ", 
     RowBox[{"normalizzate", "[", 
      RowBox[{"0", ",", 
       RowBox[{"2", "\[Pi]"}]}]}]}], ")"}], "*)"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Funzione", " ", "di", " ", "trasferimento", " ", "H", 
     RowBox[{"(", 
      RowBox[{"e", "^", "j\[Omega]"}], ")"}]}], "=", 
    RowBox[{"B", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"e", "^", "j\[Omega]"}], ")"}], "/", "A"}], 
     RowBox[{"(", 
      RowBox[{"e", "^", "j\[Omega]"}], ")"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hnum", "=", 
   RowBox[{
    RowBox[{"bCoeffs", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "+", 
    RowBox[{
     RowBox[{"bCoeffs", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "\[Omega]"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"bCoeffs", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "2", "*", "\[Omega]"}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Hden", "=", 
   RowBox[{
    RowBox[{"aCoeffs", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "+", 
    RowBox[{
     RowBox[{"aCoeffs", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "\[Omega]"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"aCoeffs", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "2", "*", "\[Omega]"}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"H", "=", 
    RowBox[{"Hnum", "/", "Hden"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Conversione", " ", "frequenza", " ", "in", " ", "Hz"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"freqsHz", "=", 
    RowBox[{"\[Omega]", "*", 
     RowBox[{"fs", "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "Pi"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Ampiezza", " ", "in", " ", "dB"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"magnitudeDB", "=", 
    RowBox[{"20", "*", 
     RowBox[{"Log10", "[", 
      RowBox[{"Abs", "[", "H", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Plot", " ", "della", " ", "risposta"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"freqsHz", ",", "magnitudeDB"}], "}"}], "]"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Magnitude (dB)\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Frequency Response (IIR)\>\""}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.958731256573204*^9, 3.958731256573862*^9}, {
  3.958731358397978*^9, 3.9587313586484528`*^9}, {3.958731399661888*^9, 
  3.9587315265773563`*^9}, {3.958731723768652*^9, 3.958731750053568*^9}, {
