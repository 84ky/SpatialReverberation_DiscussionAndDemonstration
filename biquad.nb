608c6386ba2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"notchCoeffs", "[", 
   RowBox[{
   "cutFreq_", ",", " ", "dbGain_", ",", " ", "qFactor_", ",", " ", 
    "sampleRate_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fc", "=", "cutFreq"}], ",", " ", 
      RowBox[{"gain", "=", "dbGain"}], ",", " ", 
      RowBox[{"qf", "=", "qFactor"}], ",", " ", 
      RowBox[{"sr", "=", "sampleRate"}], ",", " ", "amp", ",", " ", 
      "\[Omega]0", ",", "a", ",", "  ", "a0", ",", " ", "a1", ",", " ", "a2", 
      ",", " ", "b0", ",", " ", "b1", ",", " ", "b2", ",", " ", "bCoeffs", 
      ",", " ", "aCoeffs"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"amp", "=", 
      RowBox[{
       SuperscriptBox["10", 
        RowBox[{"gain", "/", "40"}]], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Omega]0", "=", 
      RowBox[{
       RowBox[{"2", "*", "\[Pi]", "*", 
        RowBox[{"(", 
         RowBox[{"fc", "/", "sr"}], ")"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "\[Omega]0", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "qf"}], ")"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bCoeffs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"aCoeffs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b0", "=", "1"}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"N", "@", 
         RowBox[{"Cos", "[", "\[Omega]0", "]"}]}]}], "//", "N"}]}], ";", " ", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b2", "=", "1"}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a0", "=", 
      RowBox[{
       RowBox[{"1", "+", "a"}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"N", "@", 
         RowBox[{"Cos", "[", "\[Omega]0", "]"}]}]}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a2", "=", 
      RowBox[{
       RowBox[{"1", "-", "a"}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"List", "[", 
      RowBox[{"bCoeffs", ",", " ", "aCoeffs"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9587504845845585`*^9, 3.9587507437570953`*^9}, {
  3.9587581421497803`*^9, 3.9587581700023823`*^9}, {3.9587582198334217`*^9, 
  3.958758280672735*^9}, {3.958758517002596*^9, 3.958758521602783*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"2b48a748-1384-8845-b26e-d31171a156b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plotMagnitudePhase", "[", 
   RowBox[{"coefficienti_", ",", " ", "sampleRate_", ",", " ", "numPunti_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"coeffs", "=", "coefficienti"}], ",", " ", 
      RowBox[{"fs", "=", "sampleRate"}], ",", " ", 
      RowBox[{"nFreqs", "=", "numPunti"}], ",", " ", "\[Omega]", ",", " ", 
      "numTransFunz", ",", " ", "denTransFunz", ",", " ", "transFunz", ",", 
      " ", "freqsHz", ",", " ", "magnitudeDB", ",", " ", "phase"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Omega]", "=", 
      RowBox[{"2", "*", "Pi", "*", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{"nFreqs", "-", "1"}]}], "]"}], "/", "nFreqs"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Frequenze", " ", 
        RowBox[{"normalizzate", "[", 
         RowBox[{"0", ",", 
          RowBox[{"2", "\[Pi]"}]}]}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"numTransFunz", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"coeffs", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "2", "*", "\[Omega]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"coeffs", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "\[Omega]"}], "]"}]}], "+", 
       RowBox[{"coeffs", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "3"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"denTransFunz", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"coeffs", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "2", "*", "\[Omega]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"coeffs", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "\[Omega]"}], "]"}]}], "+", 
       RowBox[{"coeffs", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "3"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"transFunz", "=", 
      RowBox[{"numTransFunz", "/", "denTransFunz"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"freqsHz", "=", 
      RowBox[{"\[Omega]", "*", 
       RowBox[{"fs", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "Pi"}], ")"}]}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Conversione", " ", "frequenza", " ", "in", " ", "Hz"}], "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"magnitudeDB", "=", 
      RowBox[{"20", "*", 
       RowBox[{"Log10", "[", 
        RowBox[{"Abs", "[", "transFunz", "]"}], "]"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Ampiezza", " ", "in", " ", "dB"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"phase", "=", 
      RowBox[{"Arg", "[", "transFunz", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"List", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ListLogLinearPlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"freqsHz", ",", "magnitudeDB"}], "}"}], "]"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Magnitude (dB)\>\""}], 
           "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Frequency Response Magnitude\>\""}], 
         ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "24000"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "64"}], ",", " ", "6"}], "}"}]}], "}"}]}], ",", 
         " ", 
         RowBox[{"Axes", "->", "True"}], ",", " ", 
         RowBox[{"Joined", "->", "True"}], ",", " ", 
         RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"freqsHz", ",", "phase"}], "}"}], "]"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Phase (radians)\>\""}],
            "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Phase Response\>\""}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "24000"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", " ", "2"}], "}"}]}], "}"}]}], ",", " ", 
         RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"BodePlot", "[", 
        RowBox[{
         RowBox[{"TransferFunctionModel", "[", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "+", 
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "+", 
             SuperscriptBox["z", 
              RowBox[{"-", "1"}]], "+", 
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "3"}], "]"}], "]"}], "+", 
             SuperscriptBox["z", 
              RowBox[{"-", "3"}]]}], 
            RowBox[{
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "+", 
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "+", 
             SuperscriptBox["z", 
              RowBox[{"-", "1"}]], "+", 
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "3"}], "]"}], "]"}], "+", 
             SuperscriptBox["z", 
              RowBox[{"-", "3"}]]}]], ",", " ", "z"}], "]"}], ",", " ", 
         RowBox[{"PlotLayout", "->", "\"\<Magnitude\>\""}], ",", " ", 
         RowBox[{"PlotLabel", "->", "\"\<Bode Magnitude\>\""}], ",", " ", 
         RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"BodePlot", "[", 
        RowBox[{
         RowBox[{"TransferFunctionModel", "[", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "+", 
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "+", 
             SuperscriptBox["z", 
              RowBox[{"-", "1"}]], "+", 
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "3"}], "]"}], "]"}], "+", 
             SuperscriptBox["z", 
              RowBox[{"-", "3"}]]}], 
            RowBox[{
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "+", 
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "+", 
             SuperscriptBox["z", 
              RowBox[{"-", "1"}]], "+", 
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "3"}], "]"}], "]"}], "+", 
             SuperscriptBox["z", 
              RowBox[{"-", "3"}]]}]], ",", " ", "z"}], "]"}], ",", " ", 
         RowBox[{"PlotLayout", "->", "\"\<Phase\>\""}], ",", " ", 
         RowBox[{"PlotRange", "->", "Full"}], ",", " ", 
         RowBox[{"PlotLabel", "->", "\"\<Bode Phase\>\""}], ",", " ", 
         RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
