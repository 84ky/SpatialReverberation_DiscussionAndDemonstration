Cell[CellGroupData[{

Cell["HighShelf Filter", "Section",
 CellChangeTimes->{{3.9587417942418365`*^9, 3.9587417963253613`*^9}, {
  3.9587985121699257`*^9, 
  3.9587985129093647`*^9}},ExpressionUUID->"d83442e3-f83f-9f44-bd65-\
ec8234ca56ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"highShelfCoeffs", "[", 
   RowBox[{"cutFreq_", ",", " ", "dbGain_", ",", " ", "qFactor_", ",", " ", 
    RowBox[{"sampleRate_", ":", "48000"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fc", "=", "cutFreq"}], ",", " ", 
      RowBox[{"gain", "=", "dbGain"}], ",", " ", 
      RowBox[{"qf", "=", "qFactor"}], ",", " ", 
      RowBox[{"sr", "=", "sampleRate"}], ",", " ", "amp", ",", " ", 
      "\[Omega]0", ",", "a", ",", "  ", "a0", ",", " ", "a1", ",", " ", "a2", 
      ",", " ", "b0", ",", " ", "b1", ",", " ", "b2", ",", " ", "bCoeffs", 
      ",", " ", "aCoeffs"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"amp", "=", 
      RowBox[{
       SuperscriptBox["10", 
        RowBox[{"gain", "/", "40"}]], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Omega]0", "=", 
      RowBox[{
       RowBox[{"2", "*", "\[Pi]", "*", 
        RowBox[{"(", 
         RowBox[{"fc", "/", "sr"}], ")"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "\[Omega]0", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "qf"}], ")"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bCoeffs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"aCoeffs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b0", "=", 
      RowBox[{
       RowBox[{"amp", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"amp", "+", "1"}], ")"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"amp", "-", "1"}], ")"}], "*", 
           RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], "+", 
          RowBox[{"2", "*", 
           RowBox[{"Sqrt", "[", "amp", "]"}], "*", "a"}]}], ")"}]}], "//", 
       "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", "amp", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"amp", "-", "1"}], ")"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"amp", "+", "1"}], ")"}], "*", 
           RowBox[{"Cos", "[", "\[Omega]0", "]"}]}]}], ")"}]}], "//", "N"}]}],
      ";", " ", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b2", "=", 
      RowBox[{
       RowBox[{"amp", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"amp", "+", "1"}], ")"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"amp", "-", "1"}], ")"}], "*", 
           RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], "-", 
          RowBox[{"2", "*", 
           RowBox[{"Sqrt", "[", "amp", "]"}], "*", "a"}]}], ")"}]}], "//", 
       "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a0", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"amp", "+", "1"}], ")"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"amp", "-", "1"}], ")"}], "*", 
         RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], "+", 
        RowBox[{"2", "*", 
         RowBox[{"Sqrt", "[", "amp", "]"}], "*", "a"}]}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a1", "=", 
      RowBox[{
       RowBox[{"2", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"amp", "-", "1"}], ")"}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"amp", "+", "1"}], ")"}], "*", 
           RowBox[{"Cos", "[", "\[Omega]0", "]"}]}]}], ")"}]}], "//", "N"}]}],
      ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"amp", "+", "1"}], ")"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"amp", "-", "1"}], ")"}], "*", 
         RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], "-", 
        RowBox[{"2", "*", 
         RowBox[{"Sqrt", "[", "amp", "]"}], "*", "a"}]}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"List", "[", 
      RowBox[{"bCoeffs", ",", " ", "aCoeffs"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9587504845845585`*^9, 3.9587507437570953`*^9}, {
  3.9587581421497803`*^9, 3.9587581700023823`*^9}, {3.9587582198334217`*^9, 
