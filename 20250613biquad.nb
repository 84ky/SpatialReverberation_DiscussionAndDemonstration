Cell[CellGroupData[{

Cell["AllPass Filter", "Section",
 CellChangeTimes->{{3.958763530261614*^9, 3.958763533617174*^9}, 
   3.958798515145399*^9, {3.9587992438549767`*^9, 
   3.958799244851116*^9}},ExpressionUUID->"177ea00f-2034-d045-b1da-\
935b5aad7859"],

Cell[BoxData[
 RowBox[{
  RowBox[{"allPassCoeffs", "[", 
   RowBox[{"cutFreq_", ",", " ", "qFactor_", ",", " ", 
    RowBox[{"sampleRate_", ":", "48000"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fc", "=", "cutFreq"}], ",", 
      RowBox[{"qf", "=", "qFactor"}], ",", " ", 
      RowBox[{"sr", "=", "sampleRate"}], ",", " ", "amp", ",", " ", 
      "\[Omega]0", ",", "a", ",", "  ", "a0", ",", " ", "a1", ",", " ", "a2", 
      ",", " ", "b0", ",", " ", "b1", ",", " ", "b2", ",", " ", "bCoeffs", 
      ",", " ", "aCoeffs"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Omega]0", "=", 
      RowBox[{
       RowBox[{"2", "*", "\[Pi]", "*", 
        RowBox[{"(", 
         RowBox[{"fc", "/", "sr"}], ")"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "\[Omega]0", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "qf"}], ")"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bCoeffs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"aCoeffs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b0", "=", 
      RowBox[{"1", "-", "a"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], "//", "N"}]}], ";", " ", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b2", "=", 
      RowBox[{"1", "+", "a"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"bCoeffs", ",", " ", "b2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a0", "=", 
      RowBox[{
       RowBox[{"1", "+", "a"}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"Cos", "[", "\[Omega]0", "]"}]}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a2", "=", 
      RowBox[{
       RowBox[{"1", "-", "a"}], "//", "N"}]}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"aCoeffs", ",", " ", "a2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"List", "[", 
      RowBox[{"bCoeffs", ",", " ", "aCoeffs"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9587504845845585`*^9, 3.9587507437570953`*^9}, {
  3.9587581421497803`*^9, 3.9587581700023823`*^9}, {3.9587582198334217`*^9, 
