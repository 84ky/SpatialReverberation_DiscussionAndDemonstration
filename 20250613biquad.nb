Cell[CellGroupData[{
Cell["plotMagnitudePhase", "Section",
 CellChangeTimes->{{3.958741806090685*^9, 3.95874180667107*^9}, {
  3.9587965734952507`*^9, 
  3.9587965889514313`*^9}},ExpressionUUID->"f1724fda-2a90-8945-a6ae-\
869e2ff45049"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plotMagnitudePhase", "[", 
   RowBox[{"coefficienti_", ",", " ", 
    RowBox[{"sampleRate_", ":", "48000"}], ",", " ", 
    RowBox[{"numPunti_", ":", "1024"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"coeffs", "=", "coefficienti"}], ",", " ", 
      RowBox[{"fs", "=", "sampleRate"}], ",", " ", 
      RowBox[{"nFreqs", "=", "numPunti"}], ",", " ", "\[Omega]", ",", " ", 
      "numTransFunz", ",", " ", "denTransFunz", ",", " ", "transFunz", ",", 
      " ", "freqsHz", ",", " ", "magnitudeDB", ",", " ", "phase"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Omega]", "=", 
      RowBox[{"2", "*", "Pi", "*", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{"nFreqs", "-", "1"}]}], "]"}], "/", "nFreqs"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Frequenze", " ", 
        RowBox[{"normalizzate", "[", 
         RowBox[{"0", ",", 
          RowBox[{"2", "\[Pi]"}]}]}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"numTransFunz", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"coeffs", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "2", "*", "\[Omega]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"coeffs", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "\[Omega]"}], "]"}]}], "+", 
       RowBox[{"coeffs", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "3"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"denTransFunz", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"coeffs", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "2", "*", "\[Omega]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"coeffs", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "\[Omega]"}], "]"}]}], "+", 
       RowBox[{"coeffs", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "3"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"transFunz", "=", 
      RowBox[{"numTransFunz", "/", "denTransFunz"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"freqsHz", "=", 
      RowBox[{"\[Omega]", "*", 
       RowBox[{"fs", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "Pi"}], ")"}]}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Conversione", " ", "frequenza", " ", "in", " ", "Hz"}], "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"magnitudeDB", "=", 
      RowBox[{"20", "*", 
       RowBox[{"Log10", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "transFunz", "]"}], "+", 
         RowBox[{"10", "^", 
          RowBox[{"-", "12"}]}]}], "]"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Ampiezza", " ", "in", " ", "dB"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"phase", "=", 
      RowBox[{"Arg", "[", "transFunz", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"List", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ListLogLinearPlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"freqsHz", ",", "magnitudeDB"}], "}"}], "]"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Magnitude (dB)\>\""}], 
           "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Frequency Response Magnitude\>\""}], 
         ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "24000"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "64"}], ",", " ", "24"}], "}"}]}], "}"}]}], ",", 
         " ", 
         RowBox[{"Axes", "->", "True"}], ",", " ", 
         RowBox[{"Joined", "->", "True"}], ",", " ", 
         RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"freqsHz", ",", "phase"}], "}"}], "]"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Phase (radians)\>\""}],
            "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Phase Response\>\""}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "24000"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "5"}], ",", " ", "5"}], "}"}]}], "}"}]}], ",", " ", 
         RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"BodePlot", "[", 
        RowBox[{
         RowBox[{"TransferFunctionModel", "[", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "*", 
              SuperscriptBox["z", 
               RowBox[{"-", "1"}]]}], "+", 
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", "3"}], "]"}], "]"}], "*", 
              SuperscriptBox["z", 
               RowBox[{"-", "3"}]]}]}], 
            RowBox[{
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "*", 
              SuperscriptBox["z", 
               RowBox[{"-", "1"}]]}], "+", 
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "3"}], "]"}], "]"}], "*", 
              SuperscriptBox["z", 
               RowBox[{"-", "3"}]]}]}]], ",", " ", "z"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "24000"}], "}"}], ",", "  ", 
         RowBox[{"PlotLayout", "->", "\"\<Magnitude\>\""}], ",", " ", 
         RowBox[{"PlotLabel", "->", "\"\<Bode Magnitude\>\""}], ",", " ", 
         RowBox[{"ImageSize", "->", "Large"}], ",", " ", 
         RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"BodePlot", "[", 
        RowBox[{
         RowBox[{"TransferFunctionModel", "[", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "*", 
              SuperscriptBox["z", 
               RowBox[{"-", "1"}]]}], "+", 
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", "3"}], "]"}], "]"}], "*", 
              SuperscriptBox["z", 
               RowBox[{"-", "3"}]]}]}], 
            RowBox[{
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "*", 
              SuperscriptBox["z", 
               RowBox[{"-", "1"}]]}], "+", 
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "3"}], "]"}], "]"}], "*", 
              SuperscriptBox["z", 
               RowBox[{"-", "3"}]]}]}]], ",", " ", "z"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "24000"}], "}"}], ",", "  ", 
         RowBox[{"PlotLayout", "->", "\"\<Phase\>\""}], ",", " ", 
         RowBox[{"PlotRange", "->", "Full"}], ",", " ", 
         RowBox[{"PlotLabel", "->", "\"\<Bode Phase\>\""}], ",", " ", 
         RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
